%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 71c832e2ef55603488cb697eb71901c4, type: 3}
  m_Name: Cenario02_deixaQueEuResolvo
  m_EditorClassIdentifier: Assembly-CSharp::DadosCenario
  nomeCenario: Deixa Que eu Resolvo
  quadros:
  - titulo: Deixa que eu resolvo
    texto: 'Dona Helena, 70 anos, precisa acompanhar alguns medicamentos e fazer
      consultas regularmente.

'
    imagem: {fileID: -5757731246420361683, guid: b64ff61895d5f8e469763bf405e44759, type: 3}
    opcoes: []
    exigeEscolha: 0
  - titulo: 
    texto: "Seu filho percebe que ela esqueceu de anotar uma consulta e come\xE7a
      a ficar preocupado."
    imagem: {fileID: 1619595243066064657, guid: 5ef4dfa50d9abfb4baa0e9eaf1c100d7, type: 3}
    opcoes: []
    exigeEscolha: 0
  - titulo: 
    texto: "Ele pega o celular dela e come\xE7a a organizar consultas, rem\xE9dios
      e hor\xE1rios sem perguntar nada.\n\nEla diz:\n\u2014 \u201CEu consigo cuidar
      disso.\u201D"
    imagem: {fileID: 8267444941350330550, guid: 6790b39eba5bd2042911d01827709411, type: 3}
    opcoes: []
    exigeEscolha: 0
  - titulo: Problema
    texto: "O filho precisa decidir como ajudar sem tirar dela o controle da pr\xF3pria
      sa\xFAde."
    imagem: {fileID: 4602621065642723066, guid: 17d01d89c69ddb3498c3f8c45bd9f6bc, type: 3}
    opcoes: []
    exigeEscolha: 0
  - titulo: "O que voc\xEA faria nessa situa\xE7\xE3o?"
    texto: 
    imagem: {fileID: 4602621065642723066, guid: 17d01d89c69ddb3498c3f8c45bd9f6bc, type: 3}
    opcoes:
    - textoOpcao: "\u201CDeixa que ele cuide de tudo. Ela j\xE1 est\xE1 velha e pode
        acabar esquecendo.\u201D"
      textoConsequencia: Negativa
      proximoQuadro: 0
    - textoOpcao: "\u201COrganiza tudo para ela, mas avisa depois o que foi feito.\u201D"
      textoConsequencia: Meio negativa
      proximoQuadro: 0
    - textoOpcao: "\u201CPergunta se ela precisa de ajuda e s\xF3 interfere quando
        ela pedir.\u201D"
      textoConsequencia: Neutra
      proximoQuadro: 0
    - textoOpcao: "\u201CAjuda a organizar as informa\xE7\xF5es, mas deixa que ela
        escolha como quer controlar seus pr\xF3prios cuidados.\u201D"
      textoConsequencia: Meio positiva
      proximoQuadro: 0
    - textoOpcao: "\u201CConversa com ela, entende quais dificuldades realmente existem
        e oferece ferramentas e apoio para que ela continue participando das decis\xF5es
        sobre a pr\xF3pria sa\xFAde.\u201D"
      textoConsequencia: Positiva
      proximoQuadro: 0
    exigeEscolha: 1
