MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 71c832e2ef55603488cb697eb71901c4, type: 3}
  m_Name: Cenario01_CasaSilenciosa
  m_EditorClassIdentifier: Assembly-CSharp::DadosCenario
  nomeCenario: A casa ficou silenciosa
  quadros:
  - titulo: A casa ficou silenciosa
    texto: "Seu Ant\xF4nio, 74 anos, mora sozinho desde que sua esposa faleceu. A
      casa continua igual, mas j\xE1 n\xE3o tem a mesma rotina."
    imagem: {fileID: -2329959863234833854, guid: 26ed22e44825b4946a300c5e11e66ab3, type: 3}
    opcoes: []
    exigeEscolha: 0
  - titulo: "Uma liga\xE7\xE3o durante a semana"
    texto: "Sua filha liga durante a semana.\n\u2014 Pai, est\xE1 tudo bem? Voc\xEA
      est\xE1 precisando de alguma coisa?\n\u2014 Estou bem. S\xF3 sinto falta de
      ter algu\xE9m por perto."
    imagem: {fileID: 9094543361801899733, guid: 1b0dbf593213cce4b9ffc5ba9900cce0, type: 3}
    opcoes: []
    exigeEscolha: 0
  - titulo: "A d\xFAvida de domingo"
    texto: "No domingo, a filha est\xE1 cansada e pensa em fazer apenas uma liga\xE7\xE3o
      r\xE1pida. Ela decide ligar e pergunta o que pode fazer para ajud\xE1-lo."
    imagem: {fileID: 1334960847774182391, guid: d7ebc84e59198b342a6c490236b34310, type: 3}
    opcoes: []
    exigeEscolha: 0
  - titulo: A falta
    texto: "Seu Ant\xF4nio diz que sente falta de ter algu\xE9m por perto. A filha
      pergunta o que pode fazer para ajud\xE1-lo."
    imagem: {fileID: 3736540879100028168, guid: f083b45aa53415640a72ebfbc53c87e6, type: 3}
    opcoes: []
    exigeEscolha: 0
  - titulo: "que voc\xEA faria nessa situa\xE7\xE3o?"
    texto: 
    imagem: {fileID: 3736540879100028168, guid: f083b45aa53415640a72ebfbc53c87e6, type: 3}
    opcoes:
    - textoOpcao: "Ele precisa se acostumar. N\xE3o d\xE1 para ficar indo l\xE1 toda
        hora."
      textoConsequencia: Negativa
      proximoQuadro: 4
    - textoOpcao: "Liga para ele de vez em quando, s\xF3 para saber se est\xE1 tudo
        bem."
      textoConsequencia: Meio negativa
      proximoQuadro: 4
    - textoOpcao: "Pergunta se ele quer companhia, mas deixa a decis\xE3o totalmente
        por conta dele."
      textoConsequencia: Neutra
      proximoQuadro: 4
    - textoOpcao: "Combina de visit\xE1-lo com mais frequ\xEAncia e procura manter
        contato durante a semana."
      textoConsequencia: Meio positiva
      proximoQuadro: 4
    - textoOpcao: "Conversa com ele sobre o que est\xE1 sentindo, combina momentos
        de conviv\xEAncia e procura ajud\xE1-lo a manter atividades e rela\xE7\xF5es
        que fa\xE7am sentido para ele."
      textoConsequencia: Positiva
      proximoQuadro: 4
    exigeEscolha: 1
