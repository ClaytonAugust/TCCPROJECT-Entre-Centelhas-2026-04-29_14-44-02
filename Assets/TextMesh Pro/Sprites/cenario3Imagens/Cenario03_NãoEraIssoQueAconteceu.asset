%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 71c832e2ef55603488cb697eb71901c4, type: 3}
  m_Name: "Cenario03_N\xE3oEraIssoQueAconteceu"
  m_EditorClassIdentifier: Assembly-CSharp::DadosCenario
  nomeCenario: "N\xE3o era isso que aconteceu"
  quadros:
  - titulo: "\u201CN\xE3o era isso que aconteceu\u201D"
    texto: Dona Maria percebe que sua carteira desapareceu depois que um parente
      esteve em sua casa.
    imagem: {fileID: -6502930645512065718, guid: e10a8f3fbe268da4eaa067d9b8fdf994, type: 3}
    opcoes: []
    exigeEscolha: 0
  - titulo: 
    texto: "o filho come\xE7a a comentar com a m\xE3e sobre o ocorrido"
    imagem: {fileID: -7979628505072989595, guid: c1d9488c85cc9394ab64cee9352ef336, type: 3}
    opcoes: []
    exigeEscolha: 0
  - titulo: 
    texto: "A hist\xF3ria vai passando de pessoa para pessoa. Ningu\xE9m pergunta
      diretamente a Dona Maria o que aconteceu."
    imagem: {fileID: -5968073420919319994, guid: fc45cad442b91654a9c2de39109a7045, type: 3}
    opcoes: []
    exigeEscolha: 0
  - titulo: Problema
    texto: "Quando finalmente falam com ela, Dona Maria descobre que j\xE1 existe
      uma hist\xF3ria sobre o que teria acontecido \u2014 mas ningu\xE9m ouviu sua
      vers\xE3o."
    imagem: {fileID: 651439732306884756, guid: 6a2cf4b61263316489815e1d580e8dcd, type: 3}
    opcoes: []
    exigeEscolha: 0
  - titulo: "O que voc\xEA faria nessa situa\xE7\xE3o?"
    texto: 
    imagem: {fileID: -8600277928187147988, guid: 3f6ab3434c5f55a44b0f2b42dbc6f9bf, type: 3}
    opcoes:
    - textoOpcao: "\u201CAcreditaria na fam\xEDlia e evitaria discutir para n\xE3o
        criar confus\xE3o.\u201D\n"
      textoConsequencia: Negativa
      proximoQuadro: 6
    - textoOpcao: "\u201COuviria Dona Maria, mas continuaria acreditando mais no
        que os outros disseram.\u201D"
      textoConsequencia: Meio negativa
      proximoQuadro: 6
    - textoOpcao: "\u201CEscutaria os dois lados antes de tirar qualquer conclus\xE3o.\u201D"
      textoConsequencia: Neutra
      proximoQuadro: 6
    - textoOpcao: "\u201CConversaria diretamente com Dona Maria e daria espa\xE7o
        para ela explicar o que aconteceu.\u201D"
      textoConsequencia: Meio positiva
      proximoQuadro: 6
    - textoOpcao: "\u201CEvitaria espalhar acusa\xE7\xF5es, conversaria diretamente
        com ela e buscaria entender os fatos antes de fazer qualquer julgamento.\u201D"
      textoConsequencia: Positiva
      proximoQuadro: 6
    exigeEscolha: 1
